# Base de datos SQLite: un único archivo local, no requiere servidor ni Docker.
DATABASE_URL="file:./dev.db"

# Puerto en el que corre la API NestJS
PORT=3001

# Tasa de interés ANUAL (como fracción decimal). 0.24 = 24%.
# El servicio la divide entre 12 para obtener la tasa mensual.
# Si esta variable no está definida, el servicio usa 0.24 como valor por defecto seguro.
TASA_INTERES_ANUAL=0.24
